#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0 WITH Swift-exception
"""Check terminal assets against the recording and pinned shared renderer."""

import argparse
import json
from pathlib import Path
import re
import subprocess
from urllib.request import urlopen


root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--renderer", type=Path)
parser.add_argument("--design", type=Path)
args = parser.parse_args()
if bool(args.renderer) != bool(args.design):
    parser.error("Use --renderer and --design together")
config = json.loads((root / ".github/presentation.json").read_text())
revision = config["design_revision"]
if not re.fullmatch(r"[0-9a-f]{40}", revision):
    raise SystemExit("Pin the shared design and renderer to a full commit SHA")
if args.renderer:
    renderer, design = args.renderer.resolve(), args.design.resolve()
else:
    scratch = root / ".build/presentation/shared"
    scratch.mkdir(parents=True, exist_ok=True)
    for source, name in [("Scripts/render-terminal.py", "render-terminal.py"), ("DESIGN.md", "DESIGN.md")]:
        with urlopen(f"https://raw.githubusercontent.com/swift-library/.github/{revision}/{source}", timeout=30) as response:
            (scratch / name).write_bytes(response.read())
    renderer, design = scratch / "render-terminal.py", scratch / "DESIGN.md"
record_path = root / "Documentation/Assets/Demo-record.json"
record = json.loads(record_path.read_text())
if record["commands"][0]["stdout"] != (root / "Examples/version.swift").read_text():
    raise SystemExit("Demo example differs from the recorded source; record it again")
subprocess.run(["python3", "-B", str(renderer), "--design", str(design),
                "--record", str(record_path), "--output-dir", str(record_path.parent), "--check"], check=True)
